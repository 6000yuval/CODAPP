{
  "name": "bo7-vod-analyzer",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "stop:dev": "kill-port 3001 5173 || node -e \"process.exit(0)\"",
    "build": "npm run stop:dev && npm run build -w server && npm run build -w client",
    "start": "npm start -w server",
    "analyze:video": "tsx scripts/analyze-video.ts",
    "rebuild:report": "tsx scripts/rebuild-coaching-report.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "kill-port": "^2.0.1"
  }
}
